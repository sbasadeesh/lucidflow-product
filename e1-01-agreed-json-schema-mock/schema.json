{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucidflow.local/schema/v3.0/common-report-cap-payload.schema.json",
  "title": "LucidFlow Common Assessment Report and CAP Payload v3.0",
  "description": "Reusable contract for any assessment size. The required scan, detection, findings, evidence, KPIs, and AI payload support zero, 100, 1,000, or more findings. PDF and CAP sections stay in the same payload. The dark-pattern taxonomy has exactly 13 entries. The Responsible Business Practices appendix is excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan",
    "detection",
    "findings",
    "evidence",
    "kpis",
    "ai_payload",
    "report",
    "assessment",
    "executive_summary",
    "cap_tracker",
    "dark_pattern_taxonomy",
    "methodology",
    "limitations"
  ],
  "properties": {
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_id",
        "started_at",
        "completed_at",
        "input_urls",
        "pages_scanned",
        "states_captured",
        "rule_versions",
        "status"
      ],
      "properties": {
        "scan_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "pages_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "states_captured": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of interface states captured during the scan."
        },
        "rule_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "version"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed"
          ]
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "reason"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "could_not_assess"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation of the detection result."
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "One item per finding. No maxItems value is set, so the same contract supports 0, 100, 1,000, or more findings.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "rule_id",
          "rule_version",
          "pattern",
          "category",
          "severity",
          "confidence",
          "status",
          "state_id",
          "evidence_ids",
          "created_at",
          "title",
          "page_name",
          "page_scanned",
          "remediation_effort",
          "owner",
          "why_this_matters",
          "remediation_fix",
          "cap_id"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "description": "Provisional severity scale. DI has not approved these values yet.",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL",
              "OBSERVED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "confirmed",
              "rejected",
              "observed"
            ]
          },
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "description": "Links this finding to one or more evidence items. An empty list is invalid.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "page_name": {
            "type": "string",
            "minLength": 1
          },
          "page_scanned": {
            "type": "string",
            "format": "uri"
          },
          "remediation_effort": {
            "type": "string",
            "enum": [
              "LOW EFFORT",
              "MEDIUM EFFORT",
              "HIGH EFFORT"
            ]
          },
          "owner": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "why_this_matters": {
            "type": "string",
            "minLength": 1
          },
          "remediation_fix": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "root_cause": {
            "type": "string"
          },
          "cap_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "One item per captured proof record. No maxItems value is set.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "finding_id",
          "url",
          "captured_at",
          "state_id",
          "rule_id",
          "screenshot_path",
          "dom_snippet"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "screenshot_path": {
            "type": "string",
            "minLength": 1
          },
          "dom_snippet": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "kpis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Code-derived counts only. Do not place AI-generated counts in this object.",
      "required": [
        "total_findings",
        "confirmed_findings",
        "candidate_findings",
        "rejected_findings",
        "by_severity",
        "by_category",
        "by_pattern"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_findings": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_findings": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_pattern": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ai_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Confirmed findings only. Rejected findings, personal data, and client-confidential data are excluded.",
      "required": [
        "included_finding_ids",
        "confirmed_findings",
        "facts_for_summary",
        "redactions_applied",
        "contains_personal_data",
        "contains_client_confidential_data",
        "generated_at"
      ],
      "properties": {
        "included_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confirmed_findings": {
          "type": "array",
          "description": "Only confirmed findings may be copied here. A rejected status is invalid.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "status",
              "pattern",
              "severity"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "confirmed"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL",
                  "OBSERVED"
                ]
              }
            }
          }
        },
        "facts_for_summary": {
          "type": "object",
          "description": "Code-derived facts for AI writing slots. Do not put model-invented counts here."
        },
        "redactions_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contains_personal_data": {
          "type": "boolean",
          "const": false
        },
        "contains_client_confidential_data": {
          "type": "boolean",
          "const": false
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "version",
        "issue_date",
        "prepared_for",
        "product_name",
        "include_responsible_business_appendix"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "issue_date": {
          "type": "string",
          "format": "date"
        },
        "prepared_for": {
          "type": "string",
          "minLength": 1
        },
        "product_name": {
          "type": "string",
          "minLength": 1
        },
        "prepared_by": {
          "type": "string"
        },
        "include_responsible_business_appendix": {
          "type": "boolean",
          "const": false,
          "description": "The Responsible Business Practices appendix is permanently excluded. true is invalid."
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_name",
        "scope_line",
        "pages_screens_assessed",
        "journey_urls",
        "scan_started_at",
        "scan_completed_at"
      ],
      "properties": {
        "scope_name": {
          "type": "string",
          "minLength": 1
        },
        "scope_line": {
          "type": "string",
          "minLength": 1
        },
        "pages_screens_assessed": {
          "type": "integer",
          "minimum": 0
        },
        "journey_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "scan_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "scan_completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executive_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "potential_findings",
        "high_critical",
        "revalidated_closed",
        "pattern_distribution",
        "overall_posture",
        "priority_themes"
      ],
      "properties": {
        "potential_findings": {
          "type": "integer",
          "minimum": 0
        },
        "high_critical": {
          "type": "integer",
          "minimum": 0
        },
        "revalidated_closed": {
          "type": "integer",
          "minimum": 0
        },
        "pattern_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "overall_posture": {
          "type": "string",
          "minLength": 1
        },
        "priority_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "theme",
              "summary"
            ],
            "properties": {
              "theme": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "cap_tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_name",
        "items"
      ],
      "properties": {
        "sheet_name": {
          "type": "string",
          "const": "CAP Tracker"
        },
        "items": {
          "type": "array",
          "description": "One CAP row per eligible finding. No maxItems value is set.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cap_id",
              "finding_id",
              "pattern",
              "severity",
              "page_scanned",
              "root_cause",
              "corrective_action",
              "owner",
              "due_date",
              "status",
              "revalidation_result",
              "revalidated_on",
              "reviewer_comments"
            ],
            "properties": {
              "cap_id": {
                "type": "string",
                "minLength": 1
              },
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL",
                  "OBSERVED"
                ]
              },
              "page_scanned": {
                "type": "string",
                "format": "uri"
              },
              "root_cause": {
                "type": "string"
              },
              "corrective_action": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "due_date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "status": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "IN PROGRESS",
                  "CLOSED",
                  "OVERDUE"
                ]
              },
              "revalidation_result": {
                "type": "string",
                "enum": [
                  "Not started",
                  "Passed",
                  "Failed",
                  "Not applicable"
                ]
              },
              "revalidated_on": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "reviewer_comments": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dark_pattern_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "section_title",
        "patterns"
      ],
      "properties": {
        "included": {
          "type": "boolean",
          "const": true
        },
        "section_title": {
          "type": "string",
          "const": "What are dark patterns?"
        },
        "patterns": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "name",
              "definition"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 13
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "summary"
      ],
      "properties": {
        "included": {
          "type": "boolean",
          "const": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "statement",
        "not_assessed_items"
      ],
      "properties": {
        "included": {
          "type": "boolean",
          "const": true
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "not_assessed_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
